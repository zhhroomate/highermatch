# ============================================
# HigherMatch™ AI 招聘平台 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# ==================== 通用配置 ====================
LOG_LEVEL=INFO
DEBUG=true
ENVIRONMENT=development

# ==================== PostgreSQL 配置 ====================
POSTGRES_USER=highermatch
POSTGRES_PASSWORD=highermatch_dev_password_2024
POSTGRES_DB=highermatch_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==================== Redis 配置 ====================
REDIS_PASSWORD=highermatch_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==================== Kafka 配置 ====================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_CONSUMER_GROUP=highermatch-consumers

# ==================== Qdrant 配置 ====================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=job_candidates

# ==================== API 网关配置 ====================
NGINX_PORT=80

# ==================== 服务端口配置 ====================
USER_SERVICE_PORT=8001
JOB_SERVICE_PORT=8002
AI_SERVICE_PORT=8004

# ==================== AI 服务配置 ====================
OPENAI_API_KEY=sk-1c9b15f7bdc74b349fc9ff1e613a86e2
OPENAI_MODEL=qwen3.5-plus
OPENAI_MAX_TOKENS=2000

# 兼容 OpenAI 格式的千问模型入口（Dashscope 兼容模式）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus
LLM_TIMEOUT=60
AI_EMBEDDING_MODEL=text-embedding-ada-002

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== CORS 配置 ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@highermatch.com
SMTP_PASSWORD=
SMTP_FROM_NAME=HigherMatch
SMTP_FROM_EMAIL=notifications@highermatch.com
PAYMENT_SECRET_KEY=mock_payment_secret_key_12345

CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==================== 文件存储配置 ====================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10

# ==================== 限流配置 ====================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ==================== 健康检查配置 ====================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# ==================== 业务配置 ====================
# 候选人匹配分数阈值
MATCH_SCORE_THRESHOLD=0.75

# 简历解析最大页数
MAX_RESUME_PAGES=10

# 职位推荐数量限制
MAX_JOB_RECOMMENDATIONS=20

# AI 模型温度参数
AI_TEMPERATURE=0.7

# ==================== 日志配置 ====================
LOG_FORMAT=json
LOG_FILE_MAX_SIZE_MB=100
LOG_FILE_BACKUP_COUNT=5

# ==================== 开发环境特有 ====================
# 设置为 true 启用 SQLAlchemy SQL 日志
SQL_ECHO=false

# 热重载
RELOAD=true